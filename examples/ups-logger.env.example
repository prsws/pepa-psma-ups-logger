# Copy to /etc/psma/ups-logger.env, then:
#   sudo chown root:psma /etc/psma/ups-logger.env && sudo chmod 640 /etc/psma/ups-logger.env
# This file holds a password. Never commit the real one.

# Required
PG_DSN=host=127.0.0.1 port=5432 dbname=psma user=psma_ups password=CHANGE_ME
UPS_NAME=myups

# Optional (defaults shown)
NUT_HOST=127.0.0.1
NUT_PORT=3493
STATE_DIR=/var/lib/psma/ups
INTERVAL_MAINS=30
INTERVAL_BATTERY=5
